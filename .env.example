# ==========================================================
# 灵感配方 Social Mood — 环境变量示例
# 用法：把本文件复制一份并改名为 .env，然后填入你自己的配置。
# 注意：不要把真实的 API Key 写进这个 .env.example 文件里！
# ==========================================================

# 服务端口
PORT=5000
FLASK_DEBUG=1

# ---------- Agnes AI 配置（OpenAI 兼容接口） ----------
# 申请地址：Agnes AI 官网；仅在 .env 中填写，不要提交到 Git
AGNES_API_KEY=sk-在这里填入你自己的密钥
AGNES_BASE_URL=https://api.agnes-ai.cn/v1
AGNES_MODEL=agnes-3.0-flash
